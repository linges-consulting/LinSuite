# LinSuite deployment configuration. Copy to `.env` (mode 0600) and fill in. Never commit `.env`.
# Loaded by app/backend/src/core/config.py (pydantic-settings) and by infra/compose.yaml.

# --- Database (three roles, see docs/adr/0001) --------------------------------------------
# Superuser / schema owner. Used by the `db` container on first boot and by Alembic.
POSTGRES_DB=linsuite
POSTGRES_USER=linsuite
POSTGRES_PASSWORD=change-me-owner

# Passwords for the two roles the baseline migration creates. The db init script sets them.
APP_DB_PASSWORD=change-me-app
PURGE_DB_PASSWORD=change-me-purge

# DSNs the backend reads. Hosts are the compose service names.
DATABASE_URL=postgresql+asyncpg://linsuite_app:change-me-app@db:5432/linsuite
DATABASE_URL_PURGE=postgresql+asyncpg://linsuite_purge:change-me-purge@db:5432/linsuite
DATABASE_URL_MIGRATE=postgresql+asyncpg://linsuite:change-me-owner@db:5432/linsuite

# --- Nightly offsite backup (docs/tech-stack.md §10, infra/backup/) -----------------------
# Password for `linsuite_backup` — SELECT only, everywhere, granted by migration 0070. The db
# init script sets it, same as the app/purge passwords above.
BACKUP_DB_PASSWORD=change-me-backup
# Plain libpq DSN `pg_dump` connects with inside the `backup` service — no `+asyncpg` here,
# the backup service is a shell script, not the Python app, and never touches core/config.py.
DATABASE_URL_BACKUP=postgresql://linsuite_backup:change-me-backup@db:5432/linsuite

# Where the nightly backup lands. One of: b2 | s3 | sftp | local. `infra/backup/backup.sh`
# validates this against RESTIC_REPOSITORY's scheme before running. `local` (a path inside the
# `backup` container) is what `docker compose up` and the CI rehearsal use out of the box.
BACKUP_TARGET=local
# restic's own repository location for the target above:
#   b2:<bucket>:<path>  |  s3:<endpoint>/<bucket>[/<path>]  |  sftp:<user>@<host>:<path>  |  /absolute/local/path
RESTIC_REPOSITORY=/restic-repo
# Encrypts the repository client-side (restic, not the app). Generate with
# `openssl rand -base64 32`. **Escrow it OFFLINE, APART FROM THE BACKUPS** (tech-stack §10):
# anyone holding both the repository and this password has plaintext health records.
RESTIC_PASSWORD=change-me-restic-password
# Set to 1 only to initialise a brand-new, empty repository (first deploy, or the rehearsal);
# the script then runs `restic init` if `restic snapshots` finds nothing there yet. Leave at 0
# in steady state, so a misconfigured or missing repository fails loudly instead of quietly
# starting a new, unrelated history.
RESTIC_INIT=0

# Backblaze B2 (BACKUP_TARGET=b2). Scope the application key to the bucket with read+write
# only — **never delete** (tech-stack §10): the server that can be ransomwared must not also
# be able to destroy its own backups. Pair with the bucket's Object Lock (runbook).
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# AWS S3, or an S3-compatible endpoint (BACKUP_TARGET=s3). Same no-delete principle: the IAM
# policy behind these credentials should grant s3:PutObject/s3:GetObject/s3:ListBucket and
# never s3:DeleteObject, backed by the bucket's Object Lock retention window.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# SFTP (BACKUP_TARGET=sftp), e.g. an on-prem NAS. restic shells out to `sftp`/`ssh`, so a
# deployment using this target mounts a private key into the `backup` service (a compose
# volume, not modelled as an env var here) and points RESTIC_REPOSITORY at
# `sftp:user@host:/path`; see the runbook for the exact mount and `known_hosts` handling.

# Standard 5-field cron syntax, UTC — when crond in the `backup` service runs the nightly
# script. Before the 03:15/03:30 UTC maintenance jobs, so a restore rehearsal always has last
# night's dump to work with.
BACKUP_SCHEDULE=0 2 * * *

# Pinged after a successful backup; `${HEALTHCHECK_URL_BACKUP}/fail` on any error (failed
# dump, failed upload, bad configuration). Unset means no ping — a no-op, not a failure — same
# shape a maintenance healthcheck URL would take. Alert if no success ping in 36 hours.
HEALTHCHECK_URL_BACKUP=

# --- Redis: cache + Celery broker/result backend ------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Logging: structured JSON to stdout. DEBUG | INFO | WARNING | ERROR -------------------
LOG_LEVEL=INFO

# --- Sessions (docs/tech-stack.md §14) ----------------------------------------------------
# HS256 signing key for session JWTs. Generate with `openssl rand -hex 32`. There is no
# default on purpose: a shipped default is a forgeable session. Changing it logs everyone
# out immediately, which is the intended emergency lever. The value below is not a secret
# and the app **refuses to boot** with it: replace it before `docker compose up`.
JWT_SECRET=change-me-openssl-rand-hex-32
# How long a Staff Mode session lasts. Long on purpose: a practitioner must not be logged
# out mid-treatment.
STAFF_SESSION_HOURS=12
# Admin Mode's short window (PRD §1), kept in Redis against the session rather than in the
# token, so it can end on idle and on demand. ADMIN_IDLE_MINUTES is the sliding part: every
# administrative request pushes it out again. ADMIN_HARD_LIMIT_MINUTES is the ceiling it
# never slides past — after that the password is required again however busy the session was.
# The PRD's range is 15–30 minutes; raising either weakens the policy, not just the UX.
ADMIN_IDLE_MINUTES=15
ADMIN_HARD_LIMIT_MINUTES=30
# `Secure` on the session cookie — the browser then only sends it over HTTPS. This template
# ships the production value. Set it to false ONLY for plain-HTTP local development, where
# the browser would otherwise never send the cookie back and nobody could stay logged in.
# A deployment that leaves it false hands the session to anyone on the network.
COOKIE_SECURE=true
# Screen new passwords against HaveIBeenPwned. Only the first 5 characters of the SHA-1
# hash leave the server (k-anonymity) — the password never does. Set false for air-gapped
# installs; the bundled common-password list is then the only screening that runs.
BREACH_CHECK_ENABLED=true
# How long a password-reset link stays usable. tech-stack §14 allows 30–60 minutes: long
# enough to survive a slow mailbox, short enough that a link left sitting in one goes stale.
# Completing a reset ends every session that account holds, everywhere.
PASSWORD_RESET_MINUTES=45
# How long an invitation to a new staff member stays usable. Far longer than a reset,
# deliberately: nobody asked for it, so it has to survive a weekend and a mailbox somebody
# only reads on Monday. Administrators can send another from Settings → Staff either way.
INVITATION_HOURS=72

# --- Multi-factor authentication (docs/tech-stack.md §14) ---------------------------------
# AES-256-GCM key for TOTP secrets at rest, 32 bytes as hex. Generate with
# `openssl rand -hex 32`. A TOTP secret cannot be hashed — the server needs it in the clear
# to verify a code — so this key is what stands between a database dump and a working
# authenticator for every enrolled account. **Escrow it like JWT_SECRET**: losing it makes
# every enrolment unreadable and every enrolled user has to be reset by an administrator.
# Changing it has the same effect, so it is not a rotation lever. Like JWT_SECRET, the value
# below is refused at boot: it has to be 64 hex characters, and it has to be yours.
MFA_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
# How long a verified second factor lets an administrator open Admin Mode windows before
# being asked for a code again. PRD §1: once per twelve hours, never on every mode switch,
# which would make the 15-minute admin window unusable.
ADMIN_MFA_INTERVAL_HOURS=12
# Single-use recovery codes issued at enrolment and when a user regenerates the set.
MFA_RECOVERY_CODE_COUNT=10
# How long an emailed one-time code stays usable. Short, because it is the lower-assurance
# path: email is not an out-of-band channel when the inbox is in the same browser.
MFA_EMAIL_OTP_MINUTES=10

# --- Documents (docs/tech-stack.md §9, docs/adr/0001 §5) ---------------------------------
# AES-256-GCM master key, 32 bytes as hex, that every client's document-encryption key is
# wrapped under. Generate with `openssl rand -hex 32` — a different value from the MFA key.
# **ESCROW IT OFFLINE, SEPARATELY FROM THE BACKUPS, AT INSTALL.** A restored database without
# this key is permanently unreadable ciphertext: ten years of signed consents and chart notes,
# in a backup that looks healthy and is worthless. Never store it in the restic repository.
# Changing it has the same effect as losing it (rotation is not built), so it is not a lever.
# Like JWT_SECRET, the value below is refused at boot: 64 hex characters, and yours.
DOCUMENT_MASTER_KEY=change-me-openssl-rand-hex-32

# --- Brute-force throttling (docs/tech-stack.md §14) --------------------------------------
# Per-account, keyed in Redis by the digest of the address that was typed — not per IP, which
# distributed credential stuffing defeats and which would make one clinic behind one NAT
# throttle itself. Per-IP volumetric limits are Traefik's job (infra/compose.yaml).
# Consecutive failed password checks — login, Admin Mode re-authentication and the current
# password on a change all feed one counter — before the account is locked.
LOCKOUT_THRESHOLD=10
# The delay after each failure doubles (1, 2, 4 … seconds) up to this ceiling. It is enforced
# as "not before this instant", never as a sleep holding a worker open.
LOCKOUT_DELAY_CAP_SECONDS=128
# How long an unbroken run of failures stays unbroken. Nothing older than this counts.
LOCKOUT_FAILURE_WINDOW_MINUTES=15
# Lock durations for a first, second, third … lockout of the same address, as JSON. The last
# entry is the ceiling. Never permanent: a lock that only an administrator can lift turns a
# known username into a way to shut a clinic's front desk down mid-shift.
LOCKOUT_TIER_MINUTES=[15,30,60,1440]
# A day without a lockout and the account stops counting as a repeat offender.
LOCKOUT_TIER_DECAY_HOURS=24
# Reset links one address may ask for per window, so the forgot-password form cannot be used
# to flood somebody's mailbox. Separate from the failure counter on purpose: asking for a
# link is not a guess at a password, and must never be able to lock an account.
RESET_REQUEST_LIMIT=3
RESET_REQUEST_WINDOW_MINUTES=15

# --- Notifications (docs/tech-stack.md §6) ------------------------------------------------
# Which implementation of the notification provider sends outgoing messages. `console` writes
# the whole message — links included — to the structured log, so a local reset link is
# retrieved with `docker compose logs worker` (delivery runs in the Celery worker, never in
# the API). This is a dev/test override only: a real deployment's sender (Resend or SMTP) is
# tenant-owned configuration on the business row (Settings, once Phase 12 Task 6 ships it),
# not this env var — leave this at `console` (or `recording` in tests) and configure the
# sender from the app instead.
NOTIFICATION_PROVIDER=console
# The origin links in outgoing messages point back at. No trailing slash. Must be the URL a
# recipient can actually reach — `http://localhost` only works for a developer on this box.
APP_BASE_URL=http://localhost
# AES-256-GCM key for the Resend/SMTP credentials stored on the business row, 32 bytes as
# hex. Generate with `openssl rand -hex 32` — a value different from both keys above. Direct
# field encryption, the same shape as MFA_ENCRYPTION_KEY: no rotation lever, escrow it the
# same way. Refused at boot if it is the placeholder, not hex, or reused from another key.
NOTIFICATION_CREDENTIAL_KEY=change-me-openssl-rand-hex-32

# --- First-run setup ----------------------------------------------------------------------
# Where the one-time setup token is written (mode 0600) on every boot until the wizard is
# completed. In compose this directory is the `appdata` volume, so it survives a container
# rebuild. The token is also printed by `docker compose logs app`.
SETUP_TOKEN_FILE=/var/lib/linsuite/setup-token

# --- Dead-man monitoring (docs/tech-stack.md §3) -------------------------------------------
# A healthcheck-ping URL (Healthchecks.io, Cronitor, or similar) the nightly partition-
# maintenance and purge tasks GET after each succeeds, so a stopped scheduler or worker is
# alerted long before a missing partition causes write failures in January. Optional: leave
# unset and neither task makes a request. A failed ping is only logged — it never fails the
# task itself.
# HEALTHCHECK_URL_MAINTENANCE=https://hc-ping.com/your-check-id

# --- Traefik ------------------------------------------------------------------------------
# Hostname the stack answers on. `localhost` for local dev; the tenant's domain in production.
APP_HOST=localhost
# Host port traefik listens on. 80 in production; change if a dev box already uses 80.
TRAEFIK_HTTP_PORT=80
# Host port for the `websecure` entrypoint (docs/runbook.md "On-prem TLS"). 443 in production.
# Live even with no certificate mounted — Traefik just answers with its own self-signed
# default until `certs/server.crt`/`certs/server.key` exist (see the runbook).
TRAEFIK_HTTPS_PORT=443

# --- Frontend dev server (only when running `npm run dev` outside compose) ----------------
# Where Vite forwards /api requests: the traefik entrypoint above.
VITE_API_PROXY=http://localhost:80
