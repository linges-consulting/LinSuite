# LinSuite deployment configuration. Copy to `.env` (mode 0600) and fill in. Never commit `.env`.
# Loaded by app/backend/src/core/config.py (pydantic-settings) and by infra/compose.yaml.

# --- Database (three roles, see docs/adr/0001) --------------------------------------------
# Superuser / schema owner. Used by the `db` container on first boot and by Alembic.
POSTGRES_DB=linsuite
POSTGRES_USER=linsuite
POSTGRES_PASSWORD=change-me-owner

# Passwords for the two roles the baseline migration creates. The db init script sets them.
APP_DB_PASSWORD=change-me-app
PURGE_DB_PASSWORD=change-me-purge

# DSNs the backend reads. Hosts are the compose service names.
DATABASE_URL=postgresql+asyncpg://linsuite_app:change-me-app@db:5432/linsuite
DATABASE_URL_PURGE=postgresql+asyncpg://linsuite_purge:change-me-purge@db:5432/linsuite
DATABASE_URL_MIGRATE=postgresql+asyncpg://linsuite:change-me-owner@db:5432/linsuite

# --- Redis: cache + Celery broker/result backend ------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Logging: structured JSON to stdout. DEBUG | INFO | WARNING | ERROR -------------------
LOG_LEVEL=INFO

# --- Sessions (docs/tech-stack.md §14) ----------------------------------------------------
# HS256 signing key for session JWTs. Generate with `openssl rand -hex 32`. There is no
# default on purpose: a shipped default is a forgeable session. Changing it logs everyone
# out immediately, which is the intended emergency lever.
JWT_SECRET=change-me-openssl-rand-hex-32
# How long a Staff Mode session lasts. Long on purpose: a practitioner must not be logged
# out mid-treatment.
STAFF_SESSION_HOURS=12
# Admin Mode's short window (PRD §1), kept in Redis against the session rather than in the
# token, so it can end on idle and on demand. ADMIN_IDLE_MINUTES is the sliding part: every
# administrative request pushes it out again. ADMIN_HARD_LIMIT_MINUTES is the ceiling it
# never slides past — after that the password is required again however busy the session was.
# The PRD's range is 15–30 minutes; raising either weakens the policy, not just the UX.
ADMIN_IDLE_MINUTES=15
ADMIN_HARD_LIMIT_MINUTES=30
# `Secure` on the session cookie — the browser then only sends it over HTTPS. This template
# ships the production value. Set it to false ONLY for plain-HTTP local development, where
# the browser would otherwise never send the cookie back and nobody could stay logged in.
# A deployment that leaves it false hands the session to anyone on the network.
COOKIE_SECURE=true
# Screen new passwords against HaveIBeenPwned. Only the first 5 characters of the SHA-1
# hash leave the server (k-anonymity) — the password never does. Set false for air-gapped
# installs; the bundled common-password list is then the only screening that runs.
BREACH_CHECK_ENABLED=true

# --- First-run setup ----------------------------------------------------------------------
# Where the one-time setup token is written (mode 0600) on every boot until the wizard is
# completed. In compose this directory is the `appdata` volume, so it survives a container
# rebuild. The token is also printed by `docker compose logs app`.
SETUP_TOKEN_FILE=/var/lib/linsuite/setup-token

# --- Traefik ------------------------------------------------------------------------------
# Hostname the stack answers on. `localhost` for local dev; the tenant's domain in production.
APP_HOST=localhost
# Host port traefik listens on. 80 in production; change if a dev box already uses 80.
TRAEFIK_HTTP_PORT=80

# --- Frontend dev server (only when running `npm run dev` outside compose) ----------------
# Where Vite forwards /api requests: the traefik entrypoint above.
VITE_API_PROXY=http://localhost:80
